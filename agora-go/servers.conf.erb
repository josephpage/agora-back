# Same contract as the Kotlin app's servers.conf.erb (access rules, client IP
# headers, Host header seen by the backend = localhost:AGORA_PORT), plus
# upstream keep-alive so nginx reuses connections to the Go server.
upstream agora_backend {
    server localhost:<%= ENV['AGORA_PORT'] %>;
    keepalive 128;
}

server {
    server_name localhost;
    listen <%= ENV['PORT'] %>;

    location / {
        <%= ENV['NGINX_API_ACCESS_RULES'] %>

        proxy_set_header  Host localhost:<%= ENV['AGORA_PORT'] %>;
        proxy_set_header  X-Remote-Address $remote_addr;
        proxy_set_header  X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_http_version 1.1;
        proxy_set_header  Connection "";
        proxy_pass http://agora_backend;
        proxy_redirect default;
    }
}
